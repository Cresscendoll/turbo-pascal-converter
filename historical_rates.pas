function GetHistoricalRate(CurrencyIndex: Integer; Year: Integer;
  var UnitsPerUSD: Double; var RateKind: Integer): Boolean;
var
  I: Integer;
begin
  GetHistoricalRate := False;
  for I := 1 to HistoricalRateCount do
    if (HistoricalRates[I].CurrencyIndex = CurrencyIndex) and
      (HistoricalRates[I].Year = Year) then
    begin
      UnitsPerUSD := HistoricalRates[I].UnitsPerUSD;
      RateKind := HistoricalRates[I].RateKind;
      GetHistoricalRate := True;
      Exit;
    end;
end;

