unit Historical_Rates;

{$mode TP}

interface

const
  FirstHistoricalYear = 1992;
  LastHistoricalYear = 2026;
  RateKindStartOfYear = 4;
  HistoricalRateCount = 1070;

type
  THistoricalRate = record
    CurrencyIndex: Integer;
    Year: Integer;
    UnitsPerUSD: Double;
    RateKind: Integer;
  end;

var
  HistoricalRates: array[1..HistoricalRateCount] of THistoricalRate;

procedure InitializeHistoricalRates;
function GetHistoricalRate(CurrencyIndex: Integer; Year: Integer;
  var UnitsPerUSD: Double; var RateKind: Integer): Boolean;

implementation

var
  RatePosition: Integer;

procedure AddRate(CurrencyIndex: Integer; Year: Integer; UnitsPerUSD: Double; RateKind: Integer);
begin
  RatePosition := RatePosition + 1;
  HistoricalRates[RatePosition].CurrencyIndex := CurrencyIndex;
  HistoricalRates[RatePosition].Year := Year;
  HistoricalRates[RatePosition].UnitsPerUSD := UnitsPerUSD;
  HistoricalRates[RatePosition].RateKind := RateKind;
end;

